# Example only: loopback HTTP for local acceptance. For remote use terminate TLS.
# Both JVMs must use the same replica set and authority policy.
# Worker-only ports need not be placed behind this load balancer.
worker_processes auto;
events { worker_connections 1024; }
http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    upstream battle_authority {
        least_conn;
        server 127.0.0.1:8081;
        server 127.0.0.1:8082;
    }
    server {
        listen 127.0.0.1:18080;
        location /api/ {
            proxy_pass http://battle_authority;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            # A response can be lost after a mutation commits. Do not replay it.
            proxy_next_upstream off;
        }
        location /ws/ {
            proxy_pass http://battle_authority;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_read_timeout 75s;
            proxy_buffering off;
            proxy_next_upstream off;
        }
    }
}
