# Copy to a private environment file; load only after provisioning the DB
# and creating the root account. No secrets in source control.
BATTLE_STATE_MODE=mongo-split
BATTLE_MONGO_URI=mongodb://REPLACE_USER:REPLACE_PASSWORD@db1.internal:27017,db2.internal:27017,db3.internal:27017/?replicaSet=battle&authSource=admin
BATTLE_MONGO_DB=battle_ex
BATTLE_MONGO_MIGRATE_LEGACY=false
BATTLE_BIND=127.0.0.1
BATTLE_PORT=8081
# Match policy must agree on all authority nodes.
BATTLE_MATCH_SCHEDULING=worker
# API instances false; worker instances true. Same JAR. A spare can use *.
BATTLE_MATCH_WORKER_ENABLED=false
BATTLE_MATCH_PARTITIONS=*
# Keep the old pool until every client has been upgraded.
BATTLE_NETWORK_POOL_SUBNETS=4096
BATTLE_NETWORK_CAPACITY_RESERVATIONS=true
BATTLE_NETWORK_INSTANCE_FENCE=true
# Provision identical signing policy and relay directory on all instances.
BATTLE_NETWORK_ISSUER_KEY_FILE=/etc/battle-ex/issuer.key
BATTLE_NETWORK_RELAY_DIRECTORY_FILE=/etc/battle-ex/relays.json
BATTLE_NETWORK_ICE=true
# Configure root UUIDs and SHA256 credential digest, not plaintext key.
BATTLE_MODERATION_KEY_SHA256=
BATTLE_OPERATIONS_ROOT_USERS=
